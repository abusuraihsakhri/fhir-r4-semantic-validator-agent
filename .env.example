# FHIR R4 Semantic Validator Agent — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env to version control.

# HMAC-SHA256 audit signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SECRET_KEY=

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock

# API server host/port
API_HOST=127.0.0.1
API_PORT=8000
